flowchart TB

    %% ==================== SINOPSIS GENERAL ====================
    subgraph SYNOPSIS["📖 Sinopsis — Narrativa del Sistema"]
        direction LR
        s_fwd["Forward — La notificación llega primero<br/>Un tenant paga → el banco del landlord envía un SMS.<br/>El teléfono Android lo captura y lo procesa.<br/>Busca si el pago ya fue reportado por el tenant.<br/>Si hay un payment pendiente → verificación automática.<br/>Si no → espera a que el tenant reporte (Reverse)."]:::synopsis
        s_rev["Reverse — El usuario reporta antes del SMS<br/>El tenant ingresa manualmente su pago desde el frontend.<br/>El sistema registra el pago y busca si el SMS ya llegó.<br/>Si hay un payment_match esperando → lo vincula.<br/>Con shadow off → verificación inmediata.<br/>Si no → el pago queda pendiente al Forward."]:::synopsis
    end

    %% ==================== BANNER DE LEYENDA (Superior) ====================
    subgraph LEGEND["CAPAS DEL SISTEMA"]
        direction LR
        l1["Controller / API"]:::legendController --- l2["Queue / Events"]:::legendQueue --- l3["Parser / Config"]:::legendParser --- l4["Service / Orchestrator"]:::legendService --- l5["State / Model"]:::legendState --- l6["Terminal State"]:::legendTerminal
    end

    %% Nodo invisible para forzar quiebre de línea
    ancora[ ]:::invisible
    SYNOPSIS --> LEGEND
    LEGEND --> ancora
    ancora --> FWD
    ancora --> REV

    %% ==================== COLUMNA IZQUIERDA: FORWARD ====================
    subgraph FWD["Forward Flow (S5a+S5b) — La notificación bancaria llega antes que el usuario reporte el pago"]
        direction TB

        fwd_narr["📌 Un tenant acaba de pagar. El banco del landlord envía un SMS.<br/>El sistema procesa la notificación e intenta vincularla<br/>con un payment existente.<br/><i>Si no hay payment todavía, el Reverse flow completa el círculo.</i>"]:::narrative_inline
        fwd_narr ~~~ f1

        subgraph F1["Fase 1: Ingesta — Recibir SMS desde el dispositivo Android"]
            f1["Recibir la notificación bancaria que el dispositivo capturó<br/>DeviceController::storeNotification() — POST /api/device/notifications<br/>Valida: bank_code, raw_body (SMS completo), dedup_hash"]:::controller
            f2["Persistir con dedup: si el hash existe, es duplicado y se ignora<br/>PaymentNotification::forceCreate() — UNIQUE(dedup_hash)<br/>parse_status → 'pending' · bank_code, raw_text inmutables"]:::state
            f2dup{"El hash ya existe<br/>en la BD?"}:::query
            f2dup_dup["DUPLICADO → descartar silenciosamente<br/>QueryException 23505 → return 200 duplicate_ignored<br/>Sin job. Terminal."]:::terminal
            f3["NUEVA → encolar procesamiento asíncrono<br/>IngestPaymentNotification::dispatch() → return 201<br/>El trabajo pesado va a un worker, no bloquea al dispositivo"]:::queue
        end

        subgraph F2["Fase 2: Parseo — Extraer datos estructurados del SMS"]
            f4["Worker toma la notificación de la cola<br/>IngestPaymentNotification::handle()<br/>Carga la notificación desde BD"]:::queue
            f5["Aplicar regex del banco para extraer: ref, monto (cents), teléfono<br/>Cada banco tiene su patrón configurable (BDV/BNC)<br/>PaymentNotificationParser::parse(bank_code, raw_text)<br/>Regex via SystemConfig (cache 1h) · normalizeAmount (VE→cents)<br/>normalizeRef (trim+uppercase) · extractLast4 phone<br/>→ ParsedPayment DTO o null"]:::parser
            f6{"El SMS coincide con<br/>el formato esperado?"}:::query
            f6n["NO → notificación fallida, no generará match<br/>markFailed('Regex did not match')<br/>parse_status → 'failed' · Terminal"]:::terminal
        end

        subgraph F3["Fase 3: Matching — Vincular la notificación con un payment pendiente"]
            f8["Registrar intento de match (cada notificación ok → un PaymentMatch)<br/>DB::transaction · PaymentMatch::createFromParsed() — firstOrCreate<br/>match_status → 'unmatched' (esperando un payment que calce)"]:::state
            f9["Buscar payments que calcen: misma ref + monto + ventana 72h<br/>Si el tenant ya reportó este pago, se vinculan automáticamente<br/>ReconciliationOrchestrator::run($match)<br/>Guard: 'unmatched' · FOR UPDATE (lock pesimista)<br/>Window: SystemConfig('reconciliation.match_window_hours', 72)<br/>Excluye payments que ya tienen otro match 'matched'"]:::service
            f10{"¿Cuántos payments<br/>candidatos?"}:::query
            f10_0["0: nadie reportó este pago aún<br/>match_status stays 'unmatched'<br/>→ Espera al Reverse flow"]:::terminal
            f10_1_guard{"1 candidato → ¿sigue Pending<br/>(race guard)?"}:::query
            f10_1_guard_n["Ya lo verificó otro proceso (race)<br/>match_status stays 'unmatched'<br/>→ Terminal · abortado"]:::terminal
            f11a{"¿Shadow mode?<br/>(sugerencia vs auto)"}:::query
            f11b["SHADOW ON: sugerido, admin debe confirmar<br/>match_status → 'pending' · payment_id linked<br/>Payment sigue 'pending' · Terminal"]:::terminal
            f11c["SHADOW OFF: auto-verificación inmediata<br/>PaymentService::verifyPayment(null)<br/>payment.status → 'verified' · verified_by → null<br/>match_status → 'matched' · matched_at → now()"]:::state
            f10_N[">1: múltiples candidatos, revisión manual<br/>match_status → 'pending'<br/>→ Dashboard conciliación"]:::terminal
        end

        subgraph F4["Fase 4: Post-procesamiento — Eventos de dominio"]
            f7["Marcar notificación como parseada (DESPUÉS de transacción commit)<br/>markParsed(parsedPayment)<br/>parse_status → 'parsed' · parsed_data JSON<br/>(amount_cents, reference, sender_phone_last4, raw_groups opt)"]:::state
            f12["Disparar eventos fuera de la transacción (IC-4)<br/>dispatchPostCommitEvents()<br/>Si shadow OFF y auto-verificado → event(PaymentVerified)<br/>  → ActivateSubscription: order→Paid, crea/actualiza Subscription<br/>Si hubo duplicado cancelado → event(PaymentCancelled)"]:::queue
            f_fail["ERROR: worker falla → notificación marcada como fallida<br/>IngestPaymentNotification::failed()<br/>markFailed(exception message) · parse_status → 'failed'"]:::terminal
            f12_note["ℹ️ PaymentCancelled solo se dispara desde<br/>detección de duplicados (no desde forward run())"]:::note
        end

        f1 --> f2 --> f2dup
        f2dup -->|Sí dup 23505| f2dup_dup
        f2dup -->|No| f3 --> f4
        f4 --> f5 --> f6
        f6 -->|No| f6n
        f6 -->|Sí| f8 --> f9 --> f10
        f10 -->|"0"| f10_0
        f10 -->|"1"| f10_1_guard
        f10_1_guard -->|No| f10_1_guard_n
        f10_1_guard -->|Sí| f11a
        f11a -->|Sí| f11b
        f11a -->|No| f11c
        f10 -->|">1"| f10_N

        f8 -.->|fin tx| f7
        f10_0 -.->|fin tx| f7
        f11b -.->|fin tx| f7
        f11c -.->|fin tx| f7
        f10_N -.->|fin tx| f7
        f10_1_guard_n -.->|fin tx| f7
        f7 --> f12
        f12 -.->|aclaración| f12_note

        f4 -.->|Exception| f_fail
        f8 -.->|Exception| f_fail

    end

    %% ==================== COLUMNA DERECHA: REVERSE ====================
    subgraph REV["Reverse Flow (S6) — El usuario reporta el pago antes de que llegue la notificación bancaria"]
        direction TB

        rev_narr["📌 El usuario reporta su pago antes de que llegue el SMS.<br/>El sistema registra el payment como pendiente y busca<br/>en la BD si ya hay una notificación SMS esperando.<br/><i>Si hay match → el pago se resuelve en segundos.</i>"]:::narrative_inline
        rev_narr ~~~ r1

        subgraph R1["Fase 1: Reporte — El tenant ingresa el pago desde el frontend"]
            r1["El usuario reporta manualmente su pago (se adelanta al SMS)<br/>Tenant PaymentController::store() — POST /billing/orders/{order}/payments<br/>Valida: orden Pending · amount ≤ remaining · ref 6-10 dígitos<br/>ref UNIQUE cross-tenant · payment method válido"]:::controller
            r2["Preparar datos del método de pago elegido<br/>Construye gatewayData:<br/>pago_movil: bank, phone, id, date, concept<br/>bank_transfer: bank, name, id, account, rif, date"]:::controller
        end

        subgraph R2["Fase 2: Registro — Crear el payment y notificar admins"]
            r3["Registrar el pago. Si ya hay uno pendiente mismo método → reusar (idempotencia)<br/>Si cambió de método → cancelar el anterior (MethodChanged)<br/>PaymentService::recordPayment(order, amount, method, config, data, ref)<br/>Resuelve gateway: resolveGateway($method)"]:::service
            r4["Gateway crea Payment + detalle atómicamente<br/>PagoMovilGateway o BankTransferGateway<br/>payment.status → 'pending' · ref normalizada via normalizeRef()<br/>→ Payment listo para verificar"]:::state
            r5["Notificar admins landlord: nuevo pago pendiente de verificación<br/>notifyLandlordAdmins()<br/>Landlord::all() → Notification PendingPaymentCreated"]:::queue
        end

        subgraph R3["Fase 3: Reverse Match — Buscar notificación SMS que coincida con este pago"]
            r6{"¿Puede hacer reverse match?<br/>Solo pago_movil + Pending<br/>Transferencias no tienen SMS"}:::query
            r6_skip["No aplica → pago queda pendiente<br/>Cuando llegue el SMS, Forward flow lo vincula<br/>Terminal · espera Forward"]:::terminal
            r6_dup{"¿Esta referencia ya<br/>tiene un match 'matched'?"}:::query
            r6_dup_yes["Sí → ya vinculada a otro pago<br/>Validación en código lo impide<br/>Skip reverse match · Terminal"]:::terminal
            r7["Buscar payment_matches unmatched con misma ref + monto<br/>SELECT payment_matches WHERE<br/>match_status='unmatched' AND parsed_reference = transaction_id (del payment)<br/>AND parsed_amount_cents = amount_cents (del payment) → first()"]:::service
            r8{"¿Hay un match<br/>esperando?"}:::query
            r9["Vincular notificación con pago (~80% de los casos: SMS llegó primero)<br/>ReconciliationOrchestrator::runReverse(match, payment)<br/>Guard 1: payment.status === Pending<br/>Guard 2: match.match_status === 'unmatched'<br/>payment_id → $payment->id"]:::service
            r10{"¿Shadow mode?"}:::query
            r10_on["SHADOW ON: sugerencia, admin confirma<br/>match_status → 'pending'<br/>Payment sigue 'pending' · Terminal"]:::terminal
            r10_off["SHADOW OFF: auto-verificación inmediata<br/>PaymentService::verifyPayment(null)<br/>payment.status → 'verified' · verified_by → null<br/>match_status → 'matched' · matched_at → now()"]:::state
        end

        subgraph R4["Fase 4: Respuesta — Eventos y redirect al frontend"]
            r11["Despachar eventos después de la transacción DB (IC-4)<br/>getPendingEvents() → event(PaymentVerified) si auto-verify<br/>Verificar payment.fresh().status<br/>Redirect con flash auto_verified al frontend"]:::controller
        end

        r1 --> r2 --> r3 --> r4 --> r5 --> r6
        r6 -->|No| r6_skip
        r6 -->|Sí| r6_dup
        r6_dup -->|Sí| r6_dup_yes
        r6_dup -->|No| r7 --> r8
        r8 -->|No| r6_skip
        r8 -->|Sí| r9 --> r10
        r10 -->|Sí| r10_on --> r11
        r10 -->|No| r10_off --> r11

    end

